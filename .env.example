# 复制成 .env.local 后填入你自己的值。.env.local 已被 .gitignore 排除，不会进仓库。

# Supabase 项目地址与 publishable key（前端和分析脚本共用）
# 控制台 → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 高德地图 Web 服务 Key（可选）
# 不填则「选地点」降级为手动输入，其余功能不受影响
VITE_AMAP_KEY=

# 只读演示账号的 user id（可选）
# 填了之后，用这个账号登录会隐藏所有写入入口。
# 真正的保证在数据库层：supabase-demo-seed.sql 会把这个账号的写权限关掉。
VITE_DEMO_USER_ID=
