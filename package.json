{
  "name": "knowledge-base",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "analysis:setup": "node scripts/analysis/setup-auth.mjs",
    "analysis:fetch": "node scripts/analysis/fetch-notes.mjs",
    "analysis:index-tags": "node scripts/analysis/rebuild-tag-index.mjs",
    "analysis:should-review": "node scripts/analysis/should-review.mjs",
    "analysis:publish-review": "node scripts/analysis/publish-review.mjs",
    "analysis:tag-alias": "node scripts/analysis/tag-alias.mjs",
    "analysis:tag-aliases": "node scripts/analysis/tag-aliases.mjs",
    "analysis:mark-success": "node scripts/analysis/mark-success.mjs",
    "analysis:status": "node scripts/analysis/status.mjs",
    "analysis:disconnect": "node scripts/analysis/disconnect.mjs",
    "analysis:test": "node --test scripts/analysis/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@supabase/supabase-js": "^2.108.2",
    "dompurify": "^3.4.11",
    "marked": "^18.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "sharp": "^0.35.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
